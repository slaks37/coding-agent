# Example environment variables for coding_agent
# Copy this file to .env and fill in your API key(s).
# Only one provider key is required; the agent auto-detects which to use.

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o, o1, etc.)
OPENAI_API_KEY=sk-...

# Google Gemini
GEMINI_API_KEY=AIza...

# OpenRouter (multi-provider gateway)
OPENROUTER_API_KEY=sk-or-...

# DeepSeek
DEEPSEEK_API_KEY=sk-...

# Groq (fast inference for open-source models)
GROQ_API_KEY=gsk_...

# Ollama (local, no key needed)
# No environment variable required — just run Ollama locally and use:
#   /model ollama/llama3.3
